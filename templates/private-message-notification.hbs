<section class="evilbram-pm-notification-content">
  <div class="evilbram-pm-notification-icon">
    {{#if senderImg}}
      <img src="{{senderImg}}" alt="{{senderLabel}}">
    {{else}}
      <i class="fa-regular fa-envelope"></i>
    {{/if}}
  </div>
  <div class="evilbram-pm-notification-text">
    <strong>{{senderLabel}}</strong>
    <span>{{evilbramPmT "Notification.MessageReceived"}}</span>
  </div>
  <div class="evilbram-pm-notification-actions">
    <button type="button" data-action="closeNotification">{{evilbramPmT "Notification.Ignore"}}</button>
    <button type="button" data-action="openDashboard"><i class="fa-solid fa-arrow-up-right-from-square"></i> {{evilbramPmT "Notification.ViewMessage"}}</button>
  </div>
</section>
