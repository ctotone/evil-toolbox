<section class="evilbram-pm-notification-content">
  <div class="evilbram-pm-notification-icon">
    <i class="fa-solid fa-envelope"></i>
  </div>
  <div class="evilbram-pm-notification-text">
    <strong>Nouveau MP de {{senderLabel}}</strong>
    <span>Un nouveau message privé vient d'arriver.</span>
  </div>
  <div class="evilbram-pm-notification-actions">
    <button type="button" data-action="closeNotification">Fermer</button>
    <button type="button" data-action="openDashboard">Ouvrir Messages privés</button>
  </div>
</section>
